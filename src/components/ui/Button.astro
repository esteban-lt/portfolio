---
interface Props {
  variant?: "default" | "outline" | "ghost";
  size?: "default" | "icon";
  href?: string;
  class?: string;
  [attr: string]: any;
}

const {
  variant = "default",
  size = "default",
  href,
  class: className,
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors duration-200 hover:cursor-none disabled:pointer-events-none disabled:opacity-50";

const variants = {
  default: "bg-skin-button-accent text-skin-inverted hover:bg-skin-button-accent-hover",
  outline: "border border-solid border-skin-hue/30 bg-transparent hover:bg-[var(--color-hover-soft)]",
  ghost: "bg-transparent hover:bg-[var(--color-hover-soft)]",
};

const sizes = {
  default: "h-9 px-4 py-2",
  icon: "h-9 w-9 shrink-0",
};

const Tag = href ? "a" : "button";
---

<Tag href={href} class:list={[base, variants[variant], sizes[size], className]} {...rest}>
  <slot />
</Tag>
